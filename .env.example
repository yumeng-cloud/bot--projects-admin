# Server
PORT=8080
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 生产必须 AUTO_SEED=0（默认关）。本地若要启动时自动 seed 再设 1。
AUTO_SEED=0

# Database
# DB_DRIVER: sqlite（默认开发）| postgres / pgx（生产 + 向量检索）
DB_DRIVER=sqlite
DATABASE_URL=./data/ai-collab.db
#
# --- PostgreSQL + pgvector（语义召回目标；勿用 sqlite-vec）---
# 可复制整份：.env.postgres（box 已装 PG17+pgvector，监听 127.0.0.1:5432）
# 干净库首启先：./scripts/pg-bootstrap.sh  （避免 public schema 42501）
# DB_DRIVER=postgres
# DATABASE_URL=postgres://aicollab:aicollab@127.0.0.1:5432/ai_collab?sslmode=disable
# AUTO_MIGRATE=1
#   → 执行 backend/internal/db/postgres/001_extensions.sql
#                       002_schema.sql（业务表）
#                       003_embeddings.sql（embedding_chunks vector(384)）
# 勿把 SQLite schema.sql 原样 Exec 到 Postgres。切换说明：docs/database.md；向量约定：docs/embed.md
# 本机起库（无 docker 时）：sudo apt-get install -y postgresql-17 postgresql-17-pgvector
# docker 可选：见 docker-compose.postgres.yml（需本机 docker）
#
# Embed：唯一路径 = OpenAI 兼容 HTTP；未设时默认本地 sidecar（禁 hash 回退）
# 开发：先起 scripts/local-embed（见该目录 README）
# EMBED_PROVIDER=http
# EMBED_BASE_URL=http://127.0.0.1:8081/v1
# EMBED_API_KEY=
# EMBED_MODEL=all-MiniLM-L6-v2
# EMBED_DIMS=384
# 生产：只换 endpoint/model/dims/key，例如
# EMBED_PROVIDER=openai
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=
# OPENAI_API_KEY=
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIMS=1536



# Auth（密码哈希为 argon2id；下列 COST 暂未使用，保留兼容）
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_TTL_HOURS=168
BCRYPT_COST=12

# Login rate limit
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SEC=60

# Timezone display default
TZ=Asia/Shanghai

# Seed（工作区 slug 固定 yumeng）
# SEED_SAMPLE_DATA=1 仅本地/演示写入样例看板数据；生产勿开（保持 0 或不设）
SEED_SAMPLE_DATA=0
SEED_ADMIN_EMAIL=admin@yumeng.tech
SEED_ADMIN_PASSWORD=Admin123!
SEED_WORKSPACE_NAME=育蒙科技

# Platform super-admin bootstrap（C2 · 生产包）
# 逗号分隔邮箱；进程冷启时将这些用户标为 is_platform_admin（已落地 05a1d35）
# 例：PLATFORM_ADMIN_EMAILS=ops@example.com,founder@example.com
PLATFORM_ADMIN_EMAILS=
# 可选：与 seed 对齐时，也可把 SEED_ADMIN_EMAIL 列入上表以便本地一键超管

# 说明：进程不自动加载 .env 文件；请 export 或用环境注入后再 `make run-backend` / `make seed`。

# Frontend (Vite)
# 开发推荐同源代理（勿写 localhost，否则用 127.0.0.1 打开页会 CORS）
VITE_API_BASE_URL=/api/v1
# 直连示例：VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1

# Public API root for one-tap join links / Bot prompts (ONE_TAP_JOIN · A3)
# Default production; self-host override. Trailing slash stripped.
PUBLIC_API_BASE=https://bot.api.sn.cn
# Optional FE origin for /join deep-link hint on the API landing page
# PUBLIC_BOARD_BASE=https://board.example.com

# Attachments (local disk; metadata in DB)
# ATTACHMENTS_DIR=./data/attachments
