# handoff-mirror 密钥清单（示例 · 勿提交真实 Key）
# 复制为 bot-keys.local（已 gitignore）后填入：
#   cp scripts/handoff-sidecar/bot-keys.example scripts/handoff-sidecar/bot-keys.local
#
# 格式：每行 name=ymk_…   （# 开头为注释）
# name 用作 MIRROR_DIR/<name>/ 目录名

memory-bot=ymk_REPLACE_ME_MEMORY
frontend-bot=ymk_REPLACE_ME_FRONTEND
# go-bot=ymk_REPLACE_ME_GO
